{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roots.local/schemas/factory-roadmap.schema.json",
  "title": "FactoryRoadmap",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "blueprint", "milestones"],
  "properties": {
    "version": {"const": 1},
    "blueprint": {"type": "string", "minLength": 1},
    "milestones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "tasks"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
          "title": {"type": "string", "minLength": 3, "maxLength": 120},
          "description": {"type": "string", "minLength": 10, "maxLength": 1000},
          "bootstrap_managed": {"type": "boolean"},
          "tasks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {"$ref": "factory-issue-plan.schema.json"}
          }
        }
      }
    }
  }
}
