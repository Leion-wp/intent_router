{
  "version": 1,
  "purpose": "Keep private-repository Actions off GitHub-hosted minute quotas without mixing untrusted product execution with privileged control-plane credentials.",
  "classes": {
    "product_ci": {
      "labels": ["self-hosted", "linux", "x64", "roots-private-ci"],
      "trust": "UNTRUSTED_PRODUCT_CODE",
      "repository_secrets_allowed": false,
      "product_checkout_allowed": true,
      "ephemeral_runner_recommended": true
    },
    "control_relay": {
      "labels": ["self-hosted", "linux", "x64", "roots-private-control"],
      "trust": "PRIVILEGED_METADATA_ONLY",
      "repository_secrets_allowed": true,
      "product_checkout_allowed": false,
      "ephemeral_runner_recommended": true
    }
  },
  "invariants": {
    "separate_runner_classes": true,
    "github_hosted_fallback_after_migration": false,
    "public_control_plane_must_not_execute_private_product_code": true,
    "quality_risk_merge_gates_unchanged": true
  }
}
