{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roots.local/schemas/factory-credential-requirements.schema.json",
  "title": "FactoryCredentialRequirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "blueprint", "services", "policy"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "blueprint": {"type": "string", "const": "roots-micro-saas-v1"},
    "services": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "required_for", "credential_names", "human_owned"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"},
          "purpose": {"type": "string", "minLength": 3, "maxLength": 300},
          "required_for": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["LOCAL", "PREVIEW", "STAGING", "PRODUCTION", "BILLING", "EMAIL", "OBSERVABILITY"]}},
          "credential_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,100}$"}},
          "human_owned": {"type": "boolean", "const": true}
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspect_values", "export_values", "create_values", "rotate_values", "readiness_authority"],
      "properties": {
        "inspect_values": {"type": "boolean", "const": false},
        "export_values": {"type": "boolean", "const": false},
        "create_values": {"type": "boolean", "const": false},
        "rotate_values": {"type": "boolean", "const": false},
        "readiness_authority": {"type": "string", "const": "HUMAN_REQUIRED"}
      }
    }
  }
}
