{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roots.local/schemas/factory-task-v1.json",
  "title": "Roots FactoryTask v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "task_id", "source", "spec", "target", "requirements", "policy", "budget", "state"],
  "properties": {
    "version": { "const": 1 },
    "task_id": { "type": "string", "pattern": "^[^#]+/[^#]+#[1-9][0-9]*$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "issue_number", "issue_url"],
      "properties": {
        "type": { "const": "github_issue" },
        "issue_number": { "type": "integer", "minimum": 1 },
        "issue_url": { "type": "string", "format": "uri" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "acceptance_criteria", "test_strategy"],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "acceptance_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "test_strategy": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "context": { "type": "object" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "cwd"],
      "properties": {
        "repository": { "type": "string", "minLength": 3 },
        "branch": { "const": "Android" },
        "cwd": { "const": "/acode-plugin" }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities"],
      "properties": {
        "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" } },
        "preferred_worker": { "type": ["string", "null"] }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_actions", "forbidden_actions", "human_gates"],
      "properties": {
        "allowed_actions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "forbidden_actions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "human_gates": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "timeout_minutes", "cost_policy"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "timeout_minutes": { "type": "integer", "minimum": 1, "maximum": 360 },
        "cost_policy": { "type": "string", "enum": ["subscription_preferred", "free_preferred", "paid_allowed", "no_paid"] }
      }
    },
    "state": { "const": "DISPATCH_READY" },
    "extensions": {
      "type": "object",
      "description": "Namespaced producer-specific metadata. Core control-plane policy must not depend on unknown extension keys."
    }
  }
}
