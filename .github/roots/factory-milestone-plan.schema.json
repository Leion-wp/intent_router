{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roots.local/schemas/factory-milestone-plan.schema.json",
  "title": "FactoryMilestonePlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repository", "roadmap_id", "milestone", "tasks"],
  "properties": {
    "version": {"const": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "roadmap_id": {"type": "string", "minLength": 1},
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
        "title": {"type": "string", "minLength": 3, "maxLength": 120},
        "description": {"type": "string", "minLength": 10, "maxLength": 1000}
      }
    },
    "tasks": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "factory-issue-plan.schema.json"}},
    "extensions": {"type": "object"}
  }
}
