{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roots.local/schemas/worker-descriptor-v1.json",
  "title": "Roots WorkerDescriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "worker_id", "status", "capabilities", "activation", "lifecycle"],
  "properties": {
    "version": { "const": 1 },
    "worker_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "status": { "type": "string", "enum": ["DISCOVERED", "ENABLED", "DEGRADED", "DISABLED"] },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "documentation", "entrypoint", "method", "auth"],
      "properties": {
        "protocol": { "type": "string", "enum": ["rest", "github_action", "cli", "sdk", "manual"] },
        "documentation": { "type": "string", "format": "uri", "pattern": "^https://" },
        "entrypoint": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "type": "string", "enum": ["api_key", "github_app", "oauth", "oidc", "github_token", "none", "manual"] },
            "secret_name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "status", "resume", "cancel"],
      "properties": {
        "start": { "type": "boolean" },
        "status": { "type": "boolean" },
        "resume": { "type": "boolean" },
        "cancel": { "type": "boolean" }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced provider-specific metadata. The control plane must not depend on it for core policy decisions."
    }
  }
}
