{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roots.local/schemas/factory-new-product-proposal.schema.json",
  "title": "FactoryNewProductProposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "proposal_id", "repository_name", "product_name", "blueprint", "one_liner", "target_user", "problem", "hypothesis", "success_metric", "validation_plan", "evidence", "risk", "complexity", "budget_request_eur", "human_gate"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "proposal_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"},
    "repository_name": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,80}$"},
    "product_name": {"type": "string", "minLength": 3, "maxLength": 120},
    "blueprint": {"const": "roots-micro-saas-v1"},
    "one_liner": {"type": "string", "minLength": 10, "maxLength": 500},
    "target_user": {"type": "string", "minLength": 5, "maxLength": 700},
    "problem": {"type": "string", "minLength": 10, "maxLength": 1200},
    "hypothesis": {"type": "string", "minLength": 10, "maxLength": 1200},
    "success_metric": {"type": "string", "minLength": 5, "maxLength": 700},
    "validation_plan": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 5, "maxLength": 500}},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 5, "maxLength": 700}},
    "risk": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "complexity": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "budget_request_eur": {"type": "integer", "minimum": 0, "maximum": 100},
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "action", "reason"],
      "properties": {
        "required": {"const": true},
        "action": {"const": "CREATE_REPOSITORY"},
        "reason": {"type": "string", "minLength": 5, "maxLength": 700}
      }
    }
  }
}
