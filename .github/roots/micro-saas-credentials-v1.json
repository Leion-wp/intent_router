{
  "version": 1,
  "blueprint": "roots-micro-saas-v1",
  "services": [
    {
      "id": "supabase",
      "purpose": "Database, authentication, storage and server-side privileged operations.",
      "required_for": ["LOCAL", "PREVIEW", "STAGING", "PRODUCTION"],
      "credential_names": ["NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_ANON_KEY", "SUPABASE_SERVICE_ROLE_KEY"],
      "human_owned": true
    },
    {
      "id": "stripe",
      "purpose": "Checkout, subscriptions, customer portal and verified billing webhooks.",
      "required_for": ["BILLING", "STAGING", "PRODUCTION"],
      "credential_names": ["STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET", "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY"],
      "human_owned": true
    },
    {
      "id": "resend",
      "purpose": "Transactional product email delivery.",
      "required_for": ["EMAIL", "STAGING", "PRODUCTION"],
      "credential_names": ["RESEND_API_KEY"],
      "human_owned": true
    },
    {
      "id": "sentry",
      "purpose": "Runtime error and release observability.",
      "required_for": ["OBSERVABILITY", "STAGING", "PRODUCTION"],
      "credential_names": ["SENTRY_DSN", "SENTRY_AUTH_TOKEN"],
      "human_owned": true
    },
    {
      "id": "posthog",
      "purpose": "Product analytics and funnel instrumentation.",
      "required_for": ["OBSERVABILITY", "STAGING", "PRODUCTION"],
      "credential_names": ["NEXT_PUBLIC_POSTHOG_KEY", "NEXT_PUBLIC_POSTHOG_HOST"],
      "human_owned": true
    },
    {
      "id": "deployment",
      "purpose": "Authorized preview/staging/production deployment provider access.",
      "required_for": ["PREVIEW", "STAGING", "PRODUCTION"],
      "credential_names": ["VERCEL_TOKEN"],
      "human_owned": true
    }
  ],
  "policy": {
    "inspect_values": false,
    "export_values": false,
    "create_values": false,
    "rotate_values": false,
    "readiness_authority": "HUMAN_REQUIRED"
  }
}
