{
  "version": 1,
  "profiles": {
    "private_ephemeral": {
      "repository_visibility": "private",
      "runner_strategy": "ephemeral_self_hosted",
      "required_labels": [
        "self-hosted",
        "linux",
        "x64",
        "roots-private-ci"
      ],
      "max_jobs_per_registration": 1,
      "automatic_github_hosted_fallback": false,
      "requires_disposable_environment": true,
      "may_execute_untrusted_pr_code": true,
      "may_hold_cross_repo_relay_secret": true
    },
    "public_control_plane": {
      "repository_visibility": "public",
      "runner_strategy": "github_hosted_standard",
      "required_labels": [
        "ubuntu-latest"
      ],
      "max_jobs_per_registration": null,
      "automatic_github_hosted_fallback": true,
      "requires_disposable_environment": false,
      "may_execute_untrusted_pr_code": false,
      "may_hold_cross_repo_relay_secret": true
    }
  },
  "managed_private_workflows": {
    "factory-ci": "private_ephemeral",
    "factory-product-event-relay": "private_ephemeral"
  }
}
